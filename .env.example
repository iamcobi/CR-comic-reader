# Copy to .env.local, or add these values to your existing .env.
# Keep API keys on the server. Never commit .env or .env.local.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ELEVENLABS_API_KEY=
# Chris — natural conversational male companion voice
ELEVENLABS_VOICE_ID=iP95p4xoKVk53GoZ742B
ELEVENLABS_VOICE_NAME=Chris
# Optional future provider. This configuration uses NVIDIA.
GEMINI_API_KEY=
GEMINI_MODEL=

# Expressive V4 voice (Chris); server-only settings.
ELEVENLABS_MODEL=eleven_v4_turbo
